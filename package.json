{
  "name": "cartoon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -H 127.0.0.1",
    "build": "next build --turbopack",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/lib/db/migrate.ts",
    "db:local:start": "node scripts/local-db.mjs start",
    "db:local:stop": "node scripts/local-db.mjs stop",
    "db:local:status": "node scripts/local-db.mjs status",
    "worker": "tsx --env-file=.env src/worker/index.ts",
    "job": "tsx --env-file=.env src/worker/enqueue.ts",
    "seed:pixel-farm": "tsx --env-file=.env src/worker/seed-pixel-farm.ts",
    "youtube:auth": "node --env-file=.env scripts/youtube-auth.mjs"
  },
  "dependencies": {
    "@langchain/core": "1.2.19",
    "@langchain/langgraph": "1.5.1",
    "@langchain/langgraph-checkpoint-postgres": "1.1.0",
    "@remotion/bundler": "4.0.537",
    "@remotion/media": "4.0.537",
    "@remotion/player": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.8.1",
    "googleapis": "187.0.0",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "^1.60.0",
    "mediabunny": "1.61.6",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.537",
    "shadcn": "^4.22.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tar-stream": "3.2.2",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/tar-stream": "3.1.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "supabase": "2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
