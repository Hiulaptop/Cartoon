# Sao chép thành .env rồi điền giá trị thật. Cách lấy: xem README.md.

# Project URL, dạng https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) hoặc anon key (eyJ...). Cả hai đều được.
# Đây là khóa công khai, an toàn để nhúng vào trình duyệt. KHÔNG dùng service_role / secret key ở đây.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cổng app trên máy host
APP_PORT=3000
