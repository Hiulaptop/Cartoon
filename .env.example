# Sao chép thành .env rồi điền giá trị thật. Cách lấy: xem README.md.

# Cổng app trên máy host
APP_PORT=3000

# ---------- 9router (gọi model qua router) ----------
# Chỉ dùng phía server, KHÔNG thêm tiền tố NEXT_PUBLIC_ để key không lộ ra trình duyệt.
# URL gốc của 9router (thường kết thúc bằng /v1 nếu router tương thích OpenAI).
# Nếu router chạy trên máy host còn app chạy trong Docker, dùng http://host.docker.internal:<port>
# thay cho http://localhost:<port>.
NINE_ROUTER_BASE_URL=
NINE_ROUTER_API_KEY=

# ---------- Database (Supabase, chỉ dùng Postgres) ----------
# Supabase → Connect → Session pooler (cổng 5432). Bí mật, chỉ dùng phía server.
DATABASE_URL=
# Tùy chọn: CA cert của Supabase (Database Settings → SSL Configuration), đường dẫn tính từ gốc repo,
# vd. certs/supabase-ca.crt. Bỏ trống thì xác minh TLS bằng kho CA hệ thống.
DATABASE_CA_CERT=

# ---------- Model qua 9router ----------
# Tên model: GET <NINE_ROUTER_BASE_URL>/models và /models/image. Giám khảo phải khác họ với model viết (spec §6).
LLM_WRITER_MODEL=ag/gemini-3-flash
LLM_JUDGE_MODEL=ag/claude-sonnet-4-6
# Ngoại lệ TẠM: true = cho giám khảo cùng họ với model viết (mất tác dụng chống thiên vị; bản ghi chấm được gắn sameFamily).
LLM_JUDGE_ALLOW_SAME_FAMILY=
IMAGE_MODEL=ag/gemini-3.1-flash-image

# ---------- Local TTS Service (VieNeu-TTS v3 Turbo) ----------
# Bỏ trống = http://tts:8080 (service tts trong docker compose). Chỉ đặt http://127.0.0.1:8080 khi chạy `npm run dev` ngoài Docker;
# KHÔNG đặt giá trị localhost trong .env khi chạy compose vì app/worker trong container sẽ không với tới tts.
LOCAL_TTS_URL=

# ---------- Lưu file ----------
# Thư mục ảnh, video. Bỏ trống = ./data. Trong Docker luôn là /app/data (mount ./data).
DATA_DIR=

# ---------- Upload YouTube (M7) ----------
# OAuth client loại Desktop app trên Google Cloud (bật YouTube Data API v3, màn hình đồng ý ở trạng thái Testing).
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# Do `npm run youtube:auth` ghi. Hết hạn sau 7 ngày khi project ở Testing: chạy lại lệnh đó.
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_TOKEN_ISSUED_AT=

# ---------- Publish qua Cloudflare Tunnel (cartoon.studev.net) ----------
# Chế độ publish: COMPOSE_PROFILES=publish  -> `docker compose up` chạy thêm service tunnel.
# Chế độ dev:     COMPOSE_PROFILES=         -> không chạy tunnel (mặc định).
# CẢNH BÁO: app KHÔNG có đăng nhập. Khi publish, ai biết URL đều tạo asset (tốn credit), duyệt, upload YouTube.
COMPOSE_PROFILES=
# Token của tunnel (Cloudflare Zero Trust > Networks > Tunnels > tunnel > Docker). Bí mật, chỉ để trong .env.
TUNNEL_TOKEN=
